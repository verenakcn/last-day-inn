  "rules": {
    "reset": {
      "when": "midnight",
      "effect": "Everything resets to the morning of the same day.",
      "except": ["anchored objects", "memory of memory-keepers"]
    },
    "memory": {
      "keepers": [
        "Anyone touching or near the clock at the moment of midnight.",
        "Anyone carrying an anchored object at midnight."
      ],
      "what_is_kept": "A fragment of memory.",
      "near_clock_definition": "TODO Q4 (in the lobby at midnight?)"
    },
    "anchoring": {
      "rule": "Objects inside or touching the clock at midnight persist through the reset.",
      "anchored_at_start": ["note"]
    },
    "note_lifecycle": {
      "each_morning": "The innkeeper finds the note while winding the clock, assumes a guest dropped it, and slides it under the player's door.",
      "applies_until": "The player carries it through a midnight (Loop 1). After that it stays in the player's inventory.",
      "loop_2_plus_innkeeper_behaviour": "TODO Q5"
    },
    "loop_cannot_end": "The wisher does not know the wish came true, so the loop never ends (MVP: no ending, see end_conditions)."
  },

  "loops": {
    "loop_1": {
      "target_duration_minutes": [2, 4],
      "intended_path": ["wake, find the note", "explore and meet NPCs", "learn of the back gate and key", "escape through the garden"],
      "escape": {
        "via": "back_gate",
        "ends_loop_immediately": "TODO Q3",
        "midnight_scene_intent": "While walking away, the clock's chime sounds as if right beside the player; the inn is ahead again. Reset.",
        "midnight_scene_text": "TODO Q13"
      },
      "player_memory": "The player remembers from Loop 1 onward because they carry the anchored note at midnight."
    },
    "loop_2_opening": {
      "wake_location": "guest_room",
      "npcs_repeat_loop_1_lines": true,
      "mira_first_line": {
        "if_mira_not_near_clock_last_midnight": ["You haven't tried the pie."],
        "if_mira_near_clock_last_midnight": ["Morning…", "(pause)", "You still haven't tried the pie."],
        "reveal_moment": "if_mira_near_clock_last_midnight",
        "when_and_where": "TODO Q8"
      }
    },
    "end_conditions": [
      { "type": "anomaly_seen", "description": "The player sees the memory anomaly (Mira's \"still\" line)." },
      { "type": "loop_limit", "description": "End of Loop 3." }
    ],
    "end_screen": {
      "prompt": "What do you think is happening?",
      "capture_answer": true
    }
  },

  "journal": {
    "toggleable": true,
    "records": "Confirmed facts only. Never conclusions or hypotheses.",
    "example_fact": "The innkeeper found the note in the clock.",
    "persists_across_loops": "TODO Q14"
  }
}
